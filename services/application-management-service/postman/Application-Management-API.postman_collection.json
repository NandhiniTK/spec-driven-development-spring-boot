{
	"info": {
		"name": "Application Management API",
		"description": "CRUD operations for application metadata management",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080/api/v1"
		}
	],
	"item": [
		{
			"name": "Health Check",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8080/actuator/health",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["actuator", "health"]
				}
			}
		},
		{
			"name": "Create Application",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"payment-service\",\n    \"description\": \"Payment processing microservice\",\n    \"version\": \"1.0.0\",\n    \"status\": \"ACTIVE\",\n    \"owner\": \"john.doe\",\n    \"technology\": \"Java Spring Boot\",\n    \"environment\": \"PROD\",\n    \"url\": \"https://payment.example.com\",\n    \"metadata\": {\n        \"team\": \"payments\",\n        \"cost-center\": \"CC-1234\"\n    }\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/applications",
					"host": ["{{baseUrl}}"],
					"path": ["applications"]
				}
			}
		},
		{
			"name": "Get Application by ID",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/applications/1",
					"host": ["{{baseUrl}}"],
					"path": ["applications", "1"]
				}
			}
		},
		{
			"name": "Get All Applications",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/applications",
					"host": ["{{baseUrl}}"],
					"path": ["applications"]
				}
			}
		},
		{
			"name": "Update Application",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"payment-service\",\n    \"description\": \"Updated payment processing microservice\",\n    \"version\": \"2.0.0\",\n    \"status\": \"ACTIVE\",\n    \"owner\": \"jane.doe\",\n    \"technology\": \"Java Spring Boot\",\n    \"environment\": \"PROD\",\n    \"url\": \"https://payment-v2.example.com\",\n    \"metadata\": {\n        \"team\": \"payments\",\n        \"cost-center\": \"CC-5678\"\n    }\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/applications/1",
					"host": ["{{baseUrl}}"],
					"path": ["applications", "1"]
				}
			}
		},
		{
			"name": "Delete Application",
			"request": {
				"method": "DELETE",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/applications/1",
					"host": ["{{baseUrl}}"],
					"path": ["applications", "1"]
				}
			}
		},
		{
			"name": "Create Application - Validation Error (blank name)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"\",\n    \"version\": \"1.0.0\",\n    \"owner\": \"john.doe\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/applications",
					"host": ["{{baseUrl}}"],
					"path": ["applications"]
				}
			}
		},
		{
			"name": "Get Application - Not Found",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/applications/999",
					"host": ["{{baseUrl}}"],
					"path": ["applications", "999"]
				}
			}
		}
	]
}
